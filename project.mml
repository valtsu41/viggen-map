name: "Viggen ELKA"
description: ""
scale: 1
metatile: 2
bounds: [4, 53, 32, 72]
center: [15, 60, 10]
format: "png"
minzoom: 6
maxzoom: 10
srs: "EPSG:3857"
Stylesheet:
  - "style.mss"
Layer:
  - id: "sea"
    name: "sea"
    geometry: "polygon"
    srs: "EPSG:3857"
    Datasource:
      type: "shape"
      file: "data/water/simplified_water_polygons.shp"

  - id: "water"
    name: "water"
    geometry: "polygon"
    Datasource:
      type: "postgis"
      table: "water"

  - id: "urban"
    name: "urban"
    geometry: "polygon"
    srs: "EPSG:3006"
    Datasource:
      type: "shape"
      file: "data/Tatorter_2023/Tatorter_2023.shp"

  - id: "railways"
    name: "railways"
    geometry: "linestring"
    srs: "EPSG:4326"
    Datasource:
      type: "shape"
      file: "data/sweden-shp/gis_osm_railways_free_1.shp"
  
  - id: "roads"
    name: "roads"
    geometry: "line"
    srs: "EPSG:4326"
    Datasource:
      type: "shape"
      file: "data/sweden-shp/gis_osm_roads_free_1.shp"

  - id: "powerlines"
    name: "powerlines"
    geometry: "line"
    srs: "EPSG:4326"
    Datasource:
      type: "geojson"
      file: "data/powerlines.geojson"
  
  - id: "adminareas"
    name: "adminareas"
    geometry: "polygon"
    Datasource:
      type: "postgis"
      table: "boundaries"

  - id: "pois"
    name: "pois"
    geometry: "point"
    Datasource:
      type: "postgis"
      table: "pois"